LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: JWT auth for token API. If set, POST /api/token and POST /token require Authorization: Bearer <jwt>
JWT_SECRET=your-secret

# Optional: SQLite DB path (default: project_root/data/coffeepho.db)
DATABASE_PATH=./data/coffeepho.db

#Twilio (for outbound manager call)
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Public URL of this backend (for Twilio webhook). Use ngrok or your deployed URL.
BASE_URL=https://your-backend.ngrok.io

# Agent: backend URL for manager-call API (default: http://localhost:8000)
BACKEND_URL=http://localhost:8000
